<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.duoc.javafxfxml.BienvenidaController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <Label fx:id="saludoLabel" style="-fx-font-size: 18px;" text="¡Bienvenido!" />
      <Button onAction="#onCerrarSesionClick" text="Cerrar sesión" />
   </children>
</VBox>
